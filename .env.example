# Copy to .env for local overrides. Never commit real credentials.
POSTGRES_DB=physics_atlas
POSTGRES_USER=physics_atlas
POSTGRES_PASSWORD=replace-for-nonlocal-use

PHYSICS_ATLAS_DATABASE_URL=postgresql+psycopg://physics_atlas:replace-for-nonlocal-use@db:5432/physics_atlas
PHYSICS_ATLAS_ENVIRONMENT=development
PHYSICS_ATLAS_CORS_ORIGINS=http://localhost:5173,http://localhost:4173
PHYSICS_ATLAS_LOG_LEVEL=INFO
PHYSICS_ATLAS_FIXTURE_MODE=true
# Installed builds may set PHYSICS_ATLAS_FIXTURE_DIRECTORY and
# PHYSICS_ATLAS_REFERENCE_DATA_PATH explicitly. Source checkouts need neither.
PHYSICS_ATLAS_WORKER_POLL_SECONDS=3600
PHYSICS_ATLAS_RESOURCE_CHECK_MAX_PER_RUN=100
PHYSICS_ATLAS_RESOURCE_CHECK_ALLOWED_HOSTS=ror.org,orcid.org,arxiv.org,inspirehep.net,doi.org,crossref.org

# Configure these only for provider-backed operation.
PHYSICS_ATLAS_CROSSREF_MAILTO=
PHYSICS_ATLAS_ORCID_CLIENT_ID=
PHYSICS_ATLAS_ORCID_CLIENT_SECRET=
PHYSICS_ATLAS_ORCID_ACCESS_TOKEN=

# The static frontend omits live mode when this is unset.
VITE_ATLAS_API_URL=http://localhost:8000/api
