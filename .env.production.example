# Copy this file to .env.production on the production host, set mode 0600,
# and replace every placeholder. Never commit the populated file.

POSTGRES_DB=physics_atlas
POSTGRES_USER=physics_atlas
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
# URL-encode reserved characters from POSTGRES_PASSWORD in this URL.
PHYSICS_ATLAS_DATABASE_URL=postgresql+psycopg://physics_atlas:REPLACE_WITH_URL_ENCODED_PASSWORD@db:5432/physics_atlas

# Bare DNS hostname only; do not include https:// or a path.
PHYSICS_ATLAS_API_DOMAIN=api.example.org
PHYSICS_ATLAS_ACME_EMAIL=operator@example.org
PHYSICS_ATLAS_LOG_LEVEL=INFO

# `hep-th-v1` is fixed by compose.production.yml and is currently the only
# supported acquisition scope. Supply only ROR IDs already evidenced by the
# bounded corpus; leave empty to skip scheduled ROR retrieval safely.
PHYSICS_ATLAS_ROR_RECORD_IDS=

# The worker wakes hourly; connector cadence remains INSPIRE/arXiv daily and
# ROR weekly. Resource checks are bounded on every worker cycle.
PHYSICS_ATLAS_WORKER_POLL_SECONDS=3600
PHYSICS_ATLAS_RESOURCE_CHECK_MAX_PER_RUN=100
PHYSICS_ATLAS_RESOURCE_CHECK_ALLOWED_HOSTS=ror.org,orcid.org,arxiv.org,inspirehep.net,doi.org,crossref.org

# Provider-side operator metadata and optional known-ID enrichment credentials.
PHYSICS_ATLAS_CROSSREF_MAILTO=operator@example.org
PHYSICS_ATLAS_ORCID_CLIENT_ID=
PHYSICS_ATLAS_ORCID_CLIENT_SECRET=
PHYSICS_ATLAS_ORCID_ACCESS_TOKEN=
